{
  "name": "national-land-acquisition-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "National Land Acquisition & Management System - Government of India",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "data:validate": "npm run data:validate --workspace=backend",
    "data:import": "npm run data:import --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
