# Environment Variables - National Land Acquisition & Management System

# Server Configuration
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/land_acquisition_db?schema=public"

# Authentication Secrets
JWT_SECRET=government_of_india_national_land_management_secret_key_2026
JWT_EXPIRES_IN=7d

# Storage Configuration
STORAGE_PATH=./storage/documents
UPLOAD_MAX_SIZE_MB=25

# Geographic Data Path
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Government of India - Open Data APIs
# Register at: https://data.gov.in/user/register → Profile → API Key
DATA_GOV_IN_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
